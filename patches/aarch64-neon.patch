From 0343fa46c30643e2f626fda0e54038a33bf7285a Mon Sep 17 00:00:00 2001
From: Justin Jacob <justsrc@noreply.code.ffmpeg.org>
Date: Sat, 21 Nov 2026 22:14:45 +0530
Subject: [PATCH 1/2] checkasm/jpeg2000dsp: test partial MCT sizes

The MCT test only uses a size that is a multiple of four, so sizes
with a partial final vector are never exercised. Test both transforms
at sizes from zero through BUF_SIZE and compare the csize samples that
the transforms produce.

Signed-off-by: Justin Jacob <justsrc@noreply.code.ffmpeg.org>
---
 tests/checkasm/jpeg2000dsp.c | 60 ++++++++++++++++++++++++++----------
 1 file changed, 44 insertions(+), 16 deletions(-)

diff --git a/tests/checkasm/jpeg2000dsp.c b/tests/checkasm/jpeg2000dsp.c
index c9158ab3de..ae11d1e78f 100644
--- a/tests/checkasm/jpeg2000dsp.c
+++ b/tests/checkasm/jpeg2000dsp.c
@@ -41,6 +41,11 @@
             src[i] = (float)rnd() / (UINT_MAX >> 5); \
     } while (0)
 
+static const int mct_sizes[] = {
+    0, 1, 2, 3, 4, 5, 7, 8, 15, 16, 17, 31, 32, 33,
+    63, 64, 65, 127, 128, 129, 255, 256, 257, 511, BUF_SIZE
+};
+
 static void check_rct_int(void)
 {
     LOCAL_ALIGNED_32(int32_t, src, [BUF_SIZE*3]);
@@ -49,18 +54,29 @@ static void check_rct_int(void)
     int32_t *ref0 = &ref[BUF_SIZE*0], *new0 = &new[BUF_SIZE*0];
     int32_t *ref1 = &ref[BUF_SIZE*1], *new1 = &new[BUF_SIZE*1];
     int32_t *ref2 = &ref[BUF_SIZE*2], *new2 = &new[BUF_SIZE*2];
+    size_t n;
 
     declare_func(void, void *src0, void *src1, void *src2, int csize);
 
+    for (n = 0; n < FF_ARRAY_ELEMS(mct_sizes); n++) {
+        int csize = mct_sizes[n];
+
+        randomize_buffers();
+        memcpy(ref, src, BUF_SIZE * 3 * sizeof(*src));
+        memcpy(new, src, BUF_SIZE * 3 * sizeof(*src));
+        call_ref(ref0, ref1, ref2, csize);
+        call_new(new0, new1, new2, csize);
+        /* Compare the csize samples the transform returns. SIMD that
+         * rounds up to a full vector may touch the caller's padding,
+         * which the decoder allocates. */
+        if (memcmp(ref0, new0, csize * sizeof(*src)) ||
+            memcmp(ref1, new1, csize * sizeof(*src)) ||
+            memcmp(ref2, new2, csize * sizeof(*src))) {
+            fprintf(stderr, "csize=%d\n", csize);
+            fail();
+        }
+    }
     randomize_buffers();
-    memcpy(ref, src, BUF_SIZE * 3 * sizeof(*src));
-    memcpy(new, src, BUF_SIZE * 3 * sizeof(*src));
-    call_ref(ref0, ref1, ref2, BUF_SIZE);
-    call_new(new0, new1, new2, BUF_SIZE);
-    if (memcmp(ref0, new0, BUF_SIZE * sizeof(*src)) ||
-        memcmp(ref1, new1, BUF_SIZE * sizeof(*src)) ||
-        memcmp(ref2, new2, BUF_SIZE * sizeof(*src)))
-        fail();
     memcpy(new, src, BUF_SIZE * 3 * sizeof(*src));
     bench_new(new0, new1, new2, BUF_SIZE);
 }
@@ -74,17 +90,29 @@ static void check_ict_float(void)
     float *ref1 = &ref[BUF_SIZE*1], *new1 = &new[BUF_SIZE*1];
     float *ref2 = &ref[BUF_SIZE*2], *new2 = &new[BUF_SIZE*2];
 
+    size_t n;
+
     declare_func(void, void *src0, void *src1, void *src2, int csize);
 
+    for (n = 0; n < FF_ARRAY_ELEMS(mct_sizes); n++) {
+        int csize = mct_sizes[n];
+
+        randomize_buffers_float();
+        memcpy(ref, src, BUF_SIZE * 3 * sizeof(*src));
+        memcpy(new, src, BUF_SIZE * 3 * sizeof(*src));
+        call_ref(ref0, ref1, ref2, csize);
+        call_new(new0, new1, new2, csize);
+        /* Compare the csize samples the transform returns. SIMD that
+         * rounds up to a full vector may touch the caller's padding,
+         * which the decoder allocates. */
+        if (!float_near_abs_eps_array(ref0, new0, 1.0e-5, csize) ||
+            !float_near_abs_eps_array(ref1, new1, 1.0e-5, csize) ||
+            !float_near_abs_eps_array(ref2, new2, 1.0e-5, csize)) {
+            fprintf(stderr, "csize=%d\n", csize);
+            fail();
+        }
+    }
     randomize_buffers_float();
-    memcpy(ref, src, BUF_SIZE * 3 * sizeof(*src));
-    memcpy(new, src, BUF_SIZE * 3 * sizeof(*src));
-    call_ref(ref0, ref1, ref2, BUF_SIZE);
-    call_new(new0, new1, new2, BUF_SIZE);
-    if (!float_near_abs_eps_array(ref0, new0, 1.0e-5, BUF_SIZE) ||
-        !float_near_abs_eps_array(ref1, new1, 1.0e-5, BUF_SIZE) ||
-        !float_near_abs_eps_array(ref2, new2, 1.0e-5, BUF_SIZE))
-        fail();
     memcpy(new, src, BUF_SIZE * 3 * sizeof(*src));
     bench_new(new0, new1, new2, BUF_SIZE);
 }
-- 
2.56.1


From 66821309e54cc65c727b450c49a4dd64d9ede848 Mon Sep 17 00:00:00 2001
From: Justin Jacob <justsrc@noreply.code.ffmpeg.org>
Date: Sat, 21 Nov 2026 17:40:05 +0530
Subject: [PATCH 2/2] avcodec/jpeg2000dsp: add aarch64 NEON ICT and RCT

aarch64 uses the C multi-component transforms. Add NEON versions of
the irreversible ICT and the reversible RCT, following the existing
x86 and RISC-V implementations.

The ICT follows the C evaluation order.

Signed-off-by: Justin Jacob <justsrc@noreply.code.ffmpeg.org>
---
 libavcodec/aarch64/Makefile                   |   2 +
 libavcodec/aarch64/jpeg2000dsp_init_aarch64.c |  37 ++++++
 libavcodec/aarch64/jpeg2000dsp_neon.S         | 119 ++++++++++++++++++
 libavcodec/jpeg2000dsp.c                      |   4 +-
 libavcodec/jpeg2000dsp.h                      |   1 +
 5 files changed, 162 insertions(+), 1 deletion(-)
 create mode 100644 libavcodec/aarch64/jpeg2000dsp_init_aarch64.c
 create mode 100644 libavcodec/aarch64/jpeg2000dsp_neon.S

diff --git a/libavcodec/aarch64/Makefile b/libavcodec/aarch64/Makefile
index e560a8c312..2e3397e915 100644
--- a/libavcodec/aarch64/Makefile
+++ b/libavcodec/aarch64/Makefile
@@ -9,6 +9,7 @@ OBJS-$(CONFIG_H264PRED)                 += aarch64/h264pred_init.o
 OBJS-$(CONFIG_H264QPEL)                 += aarch64/h264qpel_init_aarch64.o
 OBJS-$(CONFIG_HPELDSP)                  += aarch64/hpeldsp_init_aarch64.o
 OBJS-$(CONFIG_IDCTDSP)                  += aarch64/idctdsp_init_aarch64.o
+OBJS-$(CONFIG_JPEG2000_DECODER)         += aarch64/jpeg2000dsp_init_aarch64.o
 OBJS-$(CONFIG_LLVIDDSP)                 += aarch64/lossless_videodsp_init.o
 OBJS-$(CONFIG_ME_CMP)                   += aarch64/me_cmp_init_aarch64.o
 OBJS-$(CONFIG_MPEGAUDIODSP)             += aarch64/mpegaudiodsp_init.o
@@ -61,6 +62,7 @@ NEON-OBJS-$(CONFIG_HPELDSP)             += aarch64/hpeldsp_neon.o
 NEON-OBJS-$(CONFIG_HUFFYUVDSP)          += aarch64/huffyuvdsp_neon.o
 NEON-OBJS-$(CONFIG_IDCTDSP)             += aarch64/idctdsp_neon.o              \
                                            aarch64/simple_idct_neon.o
+NEON-OBJS-$(CONFIG_JPEG2000_DECODER)    += aarch64/jpeg2000dsp_neon.o
 NEON-OBJS-$(CONFIG_LLVIDDSP)            += aarch64/lossless_videodsp_neon.o
 NEON-OBJS-$(CONFIG_ME_CMP)              += aarch64/me_cmp_neon.o
 NEON-OBJS-$(CONFIG_MPEGAUDIODSP)        += aarch64/mpegaudiodsp_neon.o
diff --git a/libavcodec/aarch64/jpeg2000dsp_init_aarch64.c b/libavcodec/aarch64/jpeg2000dsp_init_aarch64.c
new file mode 100644
index 0000000000..68fecabdab
--- /dev/null
+++ b/libavcodec/aarch64/jpeg2000dsp_init_aarch64.c
@@ -0,0 +1,37 @@
+/*
+ * Copyright (c) 2026 Justin Jacob
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "libavutil/attributes.h"
+#include "libavutil/cpu.h"
+#include "libavutil/aarch64/cpu.h"
+#include "libavcodec/jpeg2000dsp.h"
+
+void ff_ict_float_neon(void *src0, void *src1, void *src2, int csize);
+void ff_rct_int_neon(void *src0, void *src1, void *src2, int csize);
+
+av_cold void ff_jpeg2000dsp_init_aarch64(Jpeg2000DSPContext *c)
+{
+    int cpu_flags = av_get_cpu_flags();
+
+    if (have_neon(cpu_flags)) {
+        c->mct_decode[FF_DWT97] = ff_ict_float_neon;
+        c->mct_decode[FF_DWT53] = ff_rct_int_neon;
+    }
+}
diff --git a/libavcodec/aarch64/jpeg2000dsp_neon.S b/libavcodec/aarch64/jpeg2000dsp_neon.S
new file mode 100644
index 0000000000..a8496048f8
--- /dev/null
+++ b/libavcodec/aarch64/jpeg2000dsp_neon.S
@@ -0,0 +1,119 @@
+/*
+ * Copyright (c) 2026 Justin Jacob
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "libavutil/aarch64/asm.S"
+
+/*
+ * Inverse irreversible color transform (float), FF_DWT97.
+ * x0 = src0, x1 = src1, x2 = src2, w3 = csize (float samples per plane)
+ *
+ * Bit-exact to the C implementation as compiled on arm64 with the default
+ * FP contraction: every multiply-accumulate is fused (fmla), and the
+ * negations of the two subtraction terms are folded into the constants,
+ * replicating the per-sample operation order of ict_float() in
+ * libavcodec/jpeg2000dsp.c.
+ */
+
+function ff_ict_float_neon, export=1
+        cbz             w3,  8f
+        mov             w8,  #0x74bc
+        movk            w8,  #0x3fb3, lsl #16
+        dup             v16.4s, w8           //  1.402
+        mov             w8,  #0x31cf
+        movk            w8,  #0xbeb0, lsl #16
+        dup             v17.4s, w8           // -0.34413
+        mov             w8,  #0xd1e1
+        movk            w8,  #0xbf36, lsl #16
+        dup             v18.4s, w8           // -0.71414
+        mov             w8,  #0xd0e5
+        movk            w8,  #0x3fe2, lsl #16
+        dup             v19.4s, w8           //  1.772
+        bic             w4,  w3, #3
+        cbz             w4,  2f
+1:      ld1             {v0.4s}, [x0]
+        ld1             {v1.4s}, [x1]
+        ld1             {v2.4s}, [x2]
+        subs            w4,  w4, #4
+        mov             v3.16b, v0.16b
+        fmla            v3.4s, v1.4s, v17.4s // i1 = src0 - 0.34413*src1
+        fmla            v3.4s, v2.4s, v18.4s // i1 = i1     - 0.71414*src2
+        mov             v4.16b, v0.16b
+        fmla            v4.4s, v1.4s, v19.4s // i2 = src0 + 1.772*src1
+        fmla            v0.4s, v2.4s, v16.4s // i0 = src0 + 1.402*src2
+        st1             {v0.4s}, [x0], #16
+        st1             {v3.4s}, [x1], #16
+        st1             {v4.4s}, [x2], #16
+        b.ne            1b
+2:      and             w3,  w3, #3
+        cbz             w3,  8f
+3:      ldr             s20, [x0]
+        ldr             s21, [x1]
+        ldr             s22, [x2]
+        fmadd           s23, s21, s17, s20   // t  = src0 - 0.34413*src1
+        fmadd           s23, s22, s18, s23   // i1 = t    - 0.71414*src2
+        fmadd           s24, s21, s19, s20   // i2 = src0 + 1.772*src1
+        fmadd           s20, s22, s16, s20   // i0 = src0 + 1.402*src2
+        str             s20, [x0], #4
+        str             s23, [x1], #4
+        str             s24, [x2], #4
+        subs            w3,  w3, #1
+        b.ne            3b
+8:      ret
+endfunc
+
+/*
+ * Reversible color transform (integer), FF_DWT53.
+ * x0 = src0, x1 = src1, x2 = src2, w3 = csize (int32 samples per plane)
+ */
+
+function ff_rct_int_neon, export=1
+        cbz             w3,  8f
+        bic             w4,  w3, #3
+        cbz             w4,  2f
+1:      ld1             {v0.4s}, [x0]
+        ld1             {v1.4s}, [x1]
+        ld1             {v2.4s}, [x2]
+        subs            w4,  w4, #4
+        add             v3.4s, v1.4s, v2.4s  // src1 + src2
+        sshr            v3.4s, v3.4s, #2
+        sub             v3.4s, v0.4s, v3.4s  // i1
+        add             v0.4s, v3.4s, v2.4s  // i0
+        add             v2.4s, v3.4s, v1.4s  // i2
+        st1             {v0.4s}, [x0], #16
+        st1             {v3.4s}, [x1], #16
+        st1             {v2.4s}, [x2], #16
+        b.ne            1b
+2:      and             w3,  w3, #3
+        cbz             w3,  8f
+3:      ldr             w5,  [x0]
+        ldr             w6,  [x1]
+        ldr             w7,  [x2]
+        add             w9,  w6, w7
+        asr             w9,  w9, #2
+        sub             w5,  w5, w9          // i1
+        add             w9,  w5, w7          // i0
+        add             w7,  w5, w6          // i2
+        str             w9,  [x0], #4
+        str             w5,  [x1], #4
+        str             w7,  [x2], #4
+        subs            w3,  w3, #1
+        b.ne            3b
+8:      ret
+endfunc
diff --git a/libavcodec/jpeg2000dsp.c b/libavcodec/jpeg2000dsp.c
index 2931a38ef1..2807e49771 100644
--- a/libavcodec/jpeg2000dsp.c
+++ b/libavcodec/jpeg2000dsp.c
@@ -96,7 +96,9 @@ av_cold void ff_jpeg2000dsp_init(Jpeg2000DSPContext *c)
     c->mct_decode[FF_DWT53]     = rct_int;
     c->mct_decode[FF_DWT97_INT] = ict_int;
 
-#if ARCH_RISCV
+#if ARCH_AARCH64
+    ff_jpeg2000dsp_init_aarch64(c);
+#elif ARCH_RISCV
     ff_jpeg2000dsp_init_riscv(c);
 #elif ARCH_X86 && HAVE_X86ASM
     ff_jpeg2000dsp_init_x86(c);
diff --git a/libavcodec/jpeg2000dsp.h b/libavcodec/jpeg2000dsp.h
index 6854c7762d..f50fee710c 100644
--- a/libavcodec/jpeg2000dsp.h
+++ b/libavcodec/jpeg2000dsp.h
@@ -33,6 +33,7 @@ typedef struct Jpeg2000DSPContext {
 extern const float ff_jpeg2000_f_ict_params[4];
 
 void ff_jpeg2000dsp_init(Jpeg2000DSPContext *c);
+void ff_jpeg2000dsp_init_aarch64(Jpeg2000DSPContext *c);
 void ff_jpeg2000dsp_init_riscv(Jpeg2000DSPContext *c);
 void ff_jpeg2000dsp_init_x86(Jpeg2000DSPContext *c);
 
-- 
2.56.1

