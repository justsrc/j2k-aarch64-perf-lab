+                        border[0][1] = x0 + w;
+                        border[1][0] = y0;
+                        border[1][1] = y0 + h;
+
+                        ret = test_dwt97_decode(border, lev, &prng);
+                        if (ret)
+                            return ret;
+                    }
+                }
+            }
+        }
+    }
+
+    return 0;
+}
 
