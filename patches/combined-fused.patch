+        max_diff = FFMAX(max_diff, diff);
+        if (!(diff <= DWT97_DIFF_TOL) && first < 0) {
+            first = (int)i;
+            first_a = arrayf_dec[i];
+            first_b = arrayf_dec_ref[i];
+        }
