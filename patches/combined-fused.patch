+                   (((i >> 3) & 1) << 2) | (((i >> 7) & 1) << 3) |
+                   (((i >> 2) & 1) << 4) | (((i >> 0) & 1) << 5) |
+                   (((i >> 8) & 1) << 6) | (((i >> 6) & 1) << 7);
